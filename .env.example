# Copy this file to `.env` and fill only the values you need.
# Do not commit `.env`.

# Default LLM backend: claude, openai, deepseek, or qwen.
PLUS_LLM_BACKEND=claude

# Optional model overrides.
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
QWEN_MODEL=qwen-max

# API keys are optional here because the app also supports entering keys in
# the Chainlit settings panel after login. Leave empty in shared examples.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional: custom SQLite memory database path.
PLUS_MEMORY_DB=

# Optional: semicolon-separated local data roots for future local-reference mode.
# Example: D:\GISData;C:\Users\your-name\Desktop\testdata
PLUS_LOCAL_DATA_ROOTS=
